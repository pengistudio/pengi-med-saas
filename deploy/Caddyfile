gentoo.pengistudio.com {
    encode zstd gzip
    reverse_proxy landing:80
}

app.gentoo.pengistudio.com {
    encode zstd gzip
    reverse_proxy web:80
}

admin.gentoo.pengistudio.com {
    encode zstd gzip
    reverse_proxy backoffice:80
}

portal.gentoo.pengistudio.com {
    encode zstd gzip
    reverse_proxy portal:80
}

api.gentoo.pengistudio.com {
    encode zstd gzip

    # /metrics is for scraping inside the Docker network only.
    handle /metrics {
        respond 404
    }

    handle {
        reverse_proxy api:8000
    }
}
