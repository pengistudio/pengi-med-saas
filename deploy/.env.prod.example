# =============================================================
# Copia este archivo como .env.prod (chmod 600) y completa los valores.
# NUNCA commitees .env.prod al repositorio.
#
# Cada variable que lee la API es un campo de apps/api/core/config.Config,
# con su tipo y default. Las marcadas "Obligatoria" hacen que la API no
# arranque si faltan; el log dice cuál. Las comentadas usan su default.
# Aplicar cambios: docker compose --env-file .env.prod -f docker-compose.prod.yaml up -d api
# (restart no vuelve a leer el archivo).
# =============================================================

# --- Base de datos (DO Managed PostgreSQL) — obligatorias ---
DB_HOST=<DO_MANAGED_DB_HOST>
DB_PORT=25060
DB_USER=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>
DB_NAME=pengi_gentoo
DB_SSL_MODE=require
# Base a la que se conecta para crear DB_NAME si no existe (DO Managed: defaultdb)
DB_ROOT_NAME=defaultdb

# --- API ---
GIN_MODE=release
PORT=8000
HTTPS_ENABLED=false
TZ=America/Guayaquil
# URL pública de la web app (links de emails, redirects, TV). Obligatoria.
# Antes FRONTEND_URL / PUBLIC_APP_URL: la API aún los lee si APP_URL falta.
APP_URL=https://app.gentoo.pengistudio.com
# Aislamiento por tenant de queries sin handle (docs/adr/0002): permissive | warn | strict
# TENANTDB_MODE=warn
# Proxies que pueden poner X-Forwarded-For. Default: loopback + redes de Docker (Caddy).
# TRUSTED_PROXIES=

# --- Auth — obligatorias ---
# Firma todos los JWT: openssl rand -base64 32. Cambiarla cierra todas las sesiones.
AUTH_KEY=<GENERA_CLAVE_ALEATORIA_32_BYTES>
# Access token, minutos
AUTH_EXP=30
# Refresh token, días
AUTH_REFRESH_EXP=30

# --- Claves de cifrado (32 bytes en base64: openssl rand -base64 32) ---
# Guarda una copia fuera del servidor: perderlas deja ilegible lo que cifran.
# Contraseñas de los P12 de firma electrónica. Obligatoria.
SIGNATURE_ENCRYPTION_KEY=<BASE64_32_BYTES>
# Adjuntos de pacientes. Sin ella los adjuntos quedan deshabilitados.
ATTACHMENT_ENCRYPTION_KEY=<BASE64_32_BYTES>
# Tokens de WhatsApp de cada clínica. Sin ella se usa SIGNATURE_ENCRYPTION_KEY.
WHATSAPP_ENCRYPTION_KEY=<BASE64_32_BYTES>

# --- Servicios internos (defaults = nombres de servicio de docker-compose.prod.yaml) ---
SRI_SIGNER_SERVICE_URL=http://sri-xml-signer:9000
# Ambiente SRI: test | prod
SRI_ENV=prod
RABBITMQ_USER=<RABBITMQ_USER>
RABBITMQ_PASSWORD=<RABBITMQ_PASSWORD>
RABBITMQ_HOST=rabbitmq
# RABBITMQ_PORT=5672
# GOTENBERG_URL=http://gotenberg:3000
ICD11_API_URL=http://icd-api:80
ICD11_LANGUAGE=es
# ICD11_RELEASE=2026-01

# --- dLocal (pasarela de pagos) ---
DLOCAL_API_KEY=<DLOCAL_API_KEY>
DLOCAL_SECRET=<DLOCAL_SECRET>
DLOCAL_ENV=production
DLOCAL_NOTIFICATION_URL=https://api.gentoo.pengistudio.com/api/v1/webhooks/dlocal

# --- Email (Resend) ---
RESEND_API_KEY=<RESEND_API_KEY>
SMTP_FROM=noreply@pengistudio.com
SMTP_FROM_NAME=Gentoo
CONTACT_EMAIL=pengiservicios@gmail.com
# Formulario de contacto del landing: envíos por IP por hora
CONTACT_RATE_LIMIT=3

# --- Google Calendar ---
GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
GOOGLE_REDIRECT_URL=https://api.gentoo.pengistudio.com/api/v1/integrations/google/callback

# --- WhatsApp reminders (Meta Cloud API) ---
META_APP_ID=<META_APP_ID>
META_APP_SECRET=<META_APP_SECRET>
META_ES_CONFIG_ID=<META_ES_CONFIG_ID>
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=<WHATSAPP_WEBHOOK_VERIFY_TOKEN>

# --- Solo la primera vez (migraciones) ---
# Contraseña para admins del backoffice que siguen con la del seed (DB20260926_1).
# Vacía = una aleatoria que nadie conoce.
# BACKOFFICE_ADMIN_PASSWORD=
# Orígenes CORS iniciales (DB20260529_1); después se editan en system_settings.
# ALLOWED_ORIGINS=

# --- Frontends ---
# No se leen de este archivo: se hornean en las imágenes desde los secrets de
# GitHub (.github/workflows/deploy.yml). VITE_API_URL (web, backoffice y
# PUBLIC_API_URL del landing), VITE_WEB_APP_URL (VITE_APP_URL del backoffice)
# y PUBLIC_APP_URL (landing).
