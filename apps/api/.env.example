DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pengi_gentoo
HTTPS_ENABLED=false
AUTH_KEY="koeDjR&|mJ!<_nR"
AUTH_EXP="30"
AUTH_REFRESH_EXP="30"
TZ=America/Guayaquil
GIN_MODE="development"
# Tenant isolation for unbound queries (docs/adr/0002): permissive | warn | strict
TENANTDB_MODE=warn

# Electronic signatures (P12 passwords at rest): 32 random bytes, base64.
# Generate with: openssl rand -base64 32. Required with GIN_MODE=release;
# changing it makes every stored signature unusable (users re-upload).
SIGNATURE_ENCRYPTION_KEY=

# Patient attachments at rest (core/tenantfiles Encrypted): 32 random bytes,
# base64, separate from the signature key. Generate with: openssl rand -base64 32.
# Required to serve attachments; losing it makes every stored attachment
# unreadable, so keep a copy outside the server.
ATTACHMENT_ENCRYPTION_KEY=

SRI_SIGNER_SERVICE_URL="http://sri-xml-signer:9000"
SRI_ENV="test"
RABBITMQ_USER="guest"
RABBITMQ_PASSWORD="guest"
PORT=8000

# dlocal Go payment gateway
DLOCAL_API_KEY=""
DLOCAL_SECRET=""
DLOCAL_ENV="sandbox"
DLOCAL_NOTIFICATION_URL="http://localhost:8000/api/v1/webhooks/dlocal"

# Email (Resend)
RESEND_API_KEY=
SMTP_FROM=noreply@pengistudio.com
SMTP_FROM_NAME=Gentoo
CONTACT_EMAIL=pengiservicios@gmail.com
CONTACT_RATE_LIMIT=100

# Google Calendar Integration
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URL="http://localhost:8000/api/v1/integrations/google/callback"
FRONTEND_URL="http://localhost:3000"


# Production only: password for backoffice admins still on the seed default
# (migration DB20260926_1). Unset = random password nobody knows.
BACKOFFICE_ADMIN_PASSWORD=
