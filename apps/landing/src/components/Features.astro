---
import UsersRound from '@lucide/astro/icons/users-round';
import CalendarDays from '@lucide/astro/icons/calendar-days';
import ScrollText from '@lucide/astro/icons/scroll-text';
import ClipboardList from '@lucide/astro/icons/clipboard-list';
import Building2 from '@lucide/astro/icons/building-complex';
import ReceiptText from '@lucide/astro/icons/receipt-text';
import MessageCircle from '@lucide/astro/icons/message-circle';
import Zap from '@lucide/astro/icons/zap';
import FlaskConical from '@lucide/astro/icons/flask-conical';
import CalendarCheck from '@lucide/astro/icons/calendar-check';
import Sparkles from '@lucide/astro/icons/sparkles';
import Wallet from '@lucide/astro/icons/wallet';
import ChartColumn from '@lucide/astro/icons/chart-column';

const features = [
    {
        icon: UsersRound,
        title: "Gestión de Pacientes",
        description: "El centro de Gentoo. Registro completo con historial médico, datos demográficos, clasificación por criticidad, evoluciones clínicas y sala de espera digital en tiempo real.",
        span: "col-span-2",
        accent: "oklch(59.929% 0.0998 185.282)",
        accentBg: "oklch(88% 0.08 185 / 35%)",
        featured: true,
    },
    {
        icon: CalendarDays,
        title: "Agenda de Citas",
        description: "Calendario diario y semanal con tipos de cita, horarios y bloqueos por médico. Se sincroniza con Google Calendar y la lista de espera llena los cupos que se liberan.",
        span: "col-span-1",
        accent: "oklch(62% 0.14 280)",
        accentBg: "oklch(85% 0.08 280 / 30%)",
    },
    {
        icon: ScrollText,
        title: "Expedientes Clínicos",
        description: "Consultas con signos vitales, diagnósticos CIE-10 o CIE-11, evoluciones y adjuntos, todo en el historial del paciente.",
        span: "col-span-1",
        accent: "oklch(65% 0.12 160)",
        accentBg: "oklch(88% 0.07 160 / 30%)",
    },
    {
        icon: ClipboardList,
        title: "Recetas, Certificados e Informes",
        description: "Documentos en PDF con tu membrete y tu propia plantilla. Fírmalos con tu firma electrónica y un código QR de verificación.",
        span: "col-span-1",
        accent: "oklch(70% 0.12 55)",
        accentBg: "oklch(90% 0.08 55 / 30%)",
    },
    {
        icon: FlaskConical,
        title: "Órdenes de Exámenes",
        description: "Pide exámenes desde la consulta con tu propio catálogo y registra los resultados en el expediente del paciente.",
        span: "col-span-1",
        accent: "oklch(60% 0.12 230)",
        accentBg: "oklch(87% 0.07 230 / 30%)",
    },
    {
        icon: CalendarCheck,
        title: "Reservas en Línea y Portal del Paciente",
        description: "Tus pacientes piden su cita desde un enlace o desde su portal, sin llamar. Tú revisas y apruebas las solicitudes desde la agenda, y si no hay cupo se anotan en la lista de espera.",
        span: "col-span-2",
        accent: "oklch(59.929% 0.0998 185.282)",
        accentBg: "oklch(88% 0.08 185 / 35%)",
    },
    {
        icon: Sparkles,
        title: "Asistente con IA",
        description: "Resume el historial del paciente, y ordena tus notas rápidas de la consulta en formato SOAP con diagnósticos sugeridos. Tú revisas todo antes de guardar.",
        span: "col-span-1",
        accent: "oklch(62% 0.14 280)",
        accentBg: "oklch(85% 0.08 280 / 30%)",
        badge: "Nuevo",
    },
    {
        icon: Wallet,
        title: "Caja",
        description: "Abre y cierra caja, registra cobros, ingresos y egresos, y cuadra el día con su reporte de cierre.",
        span: "col-span-1",
        accent: "oklch(65% 0.12 160)",
        accentBg: "oklch(88% 0.07 160 / 30%)",
    },
    {
        icon: ChartColumn,
        title: "Reportes",
        description: "Ingresos, cuentas por cobrar, citas y actividad clínica de tu consulta, listos para exportar.",
        span: "col-span-1",
        accent: "oklch(70% 0.12 55)",
        accentBg: "oklch(90% 0.08 55 / 30%)",
    },
    {
        icon: Building2,
        title: "Multi-Consultorio y Roles",
        description: "Varios consultorios, usuarios, roles y permisos desde una sola cuenta, con tablero de tareas para el equipo y registro de auditoría.",
        span: "col-span-1",
        accent: "oklch(60% 0.12 230)",
        accentBg: "oklch(87% 0.07 230 / 30%)",
    },
];
---

<section id="features" class="py-24 lg:py-32">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-2xl mx-auto mb-16">
            <div class="glass inline-flex items-center gap-2 px-4 py-2 rounded-full text-primary text-sm font-semibold mb-6">
                Funcionalidades
            </div>
            <h2 class="font-display text-4xl sm:text-5xl font-bold tracking-tight text-text mb-4">
                Todo lo que necesitas para tu consulta
            </h2>
            <p class="text-lg text-text-muted">
                Herramientas diseñadas para profesionales de la salud que buscan eficiencia y cumplimiento normativo.
            </p>
        </div>

        <!-- Bento grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {features.map((feature) => (
                <div
                    class:list={[
                        "group relative glass-card rounded-3xl p-8 transition-all duration-300 hover:scale-[1.02] cursor-default overflow-hidden",
                        feature.span === "col-span-2" ? "sm:col-span-2 lg:col-span-2" : "",
                    ]}
                    style={feature.featured ? `box-shadow: 0 8px 32px oklch(59.929% 0.0998 185.282 / 15%), inset 0 1px 0 oklch(100% 0 0 / 90%);` : ""}
                >
                    <div class="absolute top-0 right-0 w-48 h-48 rounded-full blur-3xl pointer-events-none opacity-60 group-hover:opacity-100 transition-opacity duration-500"
                        style={`background: ${feature.accentBg};`}></div>

                    {feature.featured && (
                        <div class="absolute top-4 right-4 px-2.5 py-1 rounded-full text-xs font-bold text-primary-foreground"
                            style="background: linear-gradient(135deg, oklch(59.929% 0.0998 185.282), oklch(62% 0.14 280));">
                            ✦ Principal
                        </div>
                    )}

                    {feature.badge && (
                        <div class="absolute top-4 right-4 z-20 px-2.5 py-1 rounded-full text-xs font-bold text-primary-foreground"
                            style="background: linear-gradient(135deg, oklch(62% 0.14 280), oklch(59.929% 0.0998 185.282));">
                            {feature.badge}
                        </div>
                    )}

                    <div class="relative z-10">
                        <div class="w-14 h-14 rounded-2xl flex items-center justify-center mb-5 transition-transform duration-300 group-hover:scale-110"
                            style={`background: ${feature.accentBg}; border: 1px solid ${feature.accent}30;`}>
                            <feature.icon size={28} color={feature.accent} stroke-width={1.5} />
                        </div>
                        <h3 class="font-display text-xl font-bold text-text mb-2">{feature.title}</h3>
                        <p class="text-sm text-text-muted leading-relaxed">{feature.description}</p>
                    </div>
                </div>
            ))}
        </div>

        <!-- WhatsApp: secondary row, full-width, compact horizontal -->
        <div class="mt-4 glass-card rounded-2xl px-8 py-5 flex flex-col sm:flex-row items-start sm:items-center gap-4 opacity-80 hover:opacity-100 transition-opacity duration-200">
            <div class="flex items-center gap-4 flex-1">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0"
                    style="background: oklch(88% 0.08 150 / 40%); border: 1px solid oklch(65% 0.14 150 / 30%);">
                    <MessageCircle size={20} color="oklch(55% 0.14 150)" stroke-width={1.5} />
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <span class="font-display font-semibold text-sm text-text">Recordatorios por WhatsApp</span>
                    <span class="text-sm text-text-muted">— Conecta el WhatsApp Business de tu clínica y tus pacientes reciben confirmaciones y recordatorios antes de la cita. Cuando el paciente confirma o cancela desde el mensaje, la cita se actualiza sola en tu agenda.</span>
                </div>
            </div>
        </div>

        <!-- Billing: secondary row, full-width, compact horizontal -->
        <div class="mt-4 glass-card rounded-2xl px-8 py-5 flex flex-col sm:flex-row items-start sm:items-center gap-4 opacity-80 hover:opacity-100 transition-opacity duration-200">
            <div class="flex items-center gap-4 flex-1">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0"
                    style="background: oklch(85% 0.06 260 / 40%); border: 1px solid oklch(70% 0.06 260 / 30%);">
                    <ReceiptText size={20} color="oklch(55% 0.08 260)" stroke-width={1.5} />
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <span class="font-display font-semibold text-sm text-text">Facturación Electrónica SRI</span>
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold text-white" style="background: linear-gradient(135deg, oklch(70% 0.18 55), oklch(65% 0.20 30));">
                        <Zap size={11} color="white" stroke-width={2.5} />
                        Beta
                    </span>
                    <span class="text-sm text-text-muted">— Facturas, notas de crédito y notas de débito con firma digital y autorización automática. Seguimiento de estado en tiempo real (pendiente, procesando, autorizado o fallido) con reintento en un clic si el SRI rechaza un comprobante.</span>
                </div>
            </div>
        </div>
    </div>
</section>
