# Root .env: read by docker compose (docker-compose.dev.yaml) for interpolation.
# Copy to .env (gitignored). The API's own variables live in apps/api/.env.

# Overrides the dev-only attachment key (optional).
# ATTACHMENT_ENCRYPTION_KEY=

# ngrok tunnel for the WhatsApp webhook (docs/backend/whatsapp-integration.md).
# With COMPOSE_PROFILES=tunnel, `just dev` also starts the tunnel.
# NGROK_DOMAIN: your free static domain (dashboard.ngrok.com/domains), e.g. foo-bar.ngrok-free.app
COMPOSE_PROFILES=
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
